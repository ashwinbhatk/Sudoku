component SudokuCell inherits Rectangle {
    in-out property <int> value;
    width: 50px;
    height: 50px;
    background: white;

    Text {
        text: value;
        color: green;
    }
}

export component SudokuWindow inherits Window {
    min-width: 400px;
    min-height: 400px;
    background: black;

    in property <[int]> cells;
    property <[int]> rows: [0, 1, 2, 3, 4, 5, 6, 7, 8];
    property <[int]> cols: [0, 1, 2, 3, 4, 5, 6, 7, 8];

    GridLayout {
        for row in rows: Row {
            for col in cols: SudokuCell {
                property <int> index: row * 9 + col;
                value: cells[index];
            }
        }
    }
}
